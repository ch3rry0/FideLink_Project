services:
  mongodb:
    image: mongo:latest
    container_name: fidelink_mongodb
    restart: always
    ports:
      - "MONGODB_PORT:DOCKER_PORT"
    environment:
      MONGO_INITDB_ROOT_USERNAME: yourRootUsername
      MONGO_INITDB_ROOT_PASSWORD: yourRootPassword
      MONGO_INITDB_DATABASE: fidelink
    volumes:
      - mongodb_data:/data/db
      - mongodb_config:/data/configdb
      - ./docker/mongo-init:/docker-entrypoint-initdb.d
    networks:
      - fidelink_network

  mongo-express:
    image: mongo-express:latest
    container_name: fidelink_mongo_express
    restart: always
    ports:
      - "8081:8081"
    environment:
      ME_CONFIG_MONGODB_ADMINUSERNAME: yourRootUsername
      ME_CONFIG_MONGODB_ADMINPASSWORD: yourRootPassword
      ME_CONFIG_MONGODB_URL: mongodb://yourRootUsername:yourRootPassword@mongodb:27017/
      ME_CONFIG_BASICAUTH_USERNAME: yourRootUsername
      ME_CONFIG_BASICAUTH_PASSWORD: yourRootPassword
    depends_on:
      - mongodb
    networks:
      - fidelink_network

volumes:
  mongodb_data:
    driver: local
  mongodb_config:
    driver: local

networks:
  fidelink_network:
    driver: bridge
